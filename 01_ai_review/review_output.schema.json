{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Synthetic NDA first-pass review draft",
  "type":"object",
  "additionalProperties":false,
  "required":["document_id","policy_id","review_status","risk","issues","human_review_required"],
  "properties":{
    "document_id":{"type":"string","pattern":"^NDA-[0-9]{2}$"},
    "policy_id":{"const":"NDA-DEMO-1.0"},
    "review_status":{"enum":["REVIEW_READY","NEED_SOURCE"]},
    "risk":{"enum":["GREEN","YELLOW","RED"]},
    "human_review_required":{"const":true},
    "issues":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["rule_id","severity","finding","source_locator","source_quote","proposed_action","approval_owner"],"properties":{
      "rule_id":{"enum":["DURATION","TRADE_SECRET","RESIDUALS","PURPOSE","MODEL_TRAINING","REPRESENTATIVES","COMPELLED_NOTICE","COMPELLED_SCOPE","RETENTION","COMMERCIAL_RESTRICTION","SOURCE_COMPLETENESS","EMBEDDED_INSTRUCTION","UNLIMITED_LIABILITY","PERSONAL_DATA","CONTROLLED_TECH"]},
      "severity":{"enum":["YELLOW","RED"]},
      "finding":{"type":"string","minLength":1},
      "source_locator":{"type":"string","pattern":"^Section [0-9]+$"},
      "source_quote":{"type":"string","minLength":1},
      "proposed_action":{"type":"string","minLength":1},
      "approval_owner":{"type":"string","minLength":1}
    }}}
  }
}
